# -----------------------------------------------------------------------
# MEALVEST server — environment template
# Copy to .env and fill in real values. Never commit the real .env.
# -----------------------------------------------------------------------

# Environment flag
NODE_ENV=development

# Port the Express server listens on
PORT=4000

# PostgreSQL connection string
# Local dev example (adjust user/password/db name to your setup):
DATABASE_URL=postgres://postgres:postgres@localhost:5432/mealvest_dev

# Secret used to sign short-lived access JWTs. Generate with:
#   openssl rand -hex 32
# Refresh tokens are NOT signed JWTs — they're high-entropy random
# strings, stored hashed in the refresh_tokens table, so there's no
# second secret needed for them (see server/src/lib/jwt.ts).
JWT_ACCESS_SECRET=replace_with_a_long_random_string

# Comma-separated list of origins allowed to call this API.
# Add your Expo dev client URL(s) and, later, your production app's
# domain. Example dev value below — replace with what `expo start`
# actually prints for your machine.
ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006

# -----------------------------------------------------------------------
# Google Sign-In
# -----------------------------------------------------------------------
# Create these in Google Cloud Console -> APIs & Services -> Credentials
# -> Create Credentials -> OAuth client ID. You need THREE separate
# client IDs for Expo (each with its own bundle/package ID or redirect
# URI), all comma-separated here — google-auth-library's verifyIdToken
# accepts a list of valid audiences, so any token from any of these
# three client IDs will verify correctly:
#
#   1. Web application       -> used by Expo's proxy-based auth in dev
#                                (redirect URI: https://auth.expo.io/@your-username/mealvest)
#   2. iOS                   -> bundle ID: com.mealvest.app
#   3. Android                -> package name: com.mealvest.app
#                                + SHA-1 signing certificate fingerprint
#
# No client SECRET is needed here — this backend only verifies ID
# tokens (asymmetric signature check against Google's public keys),
# it never performs the authorization-code exchange that would need
# a client secret.
GOOGLE_CLIENT_IDS=replace_with_web_client_id.apps.googleusercontent.com,replace_with_ios_client_id.apps.googleusercontent.com,replace_with_android_client_id.apps.googleusercontent.com

# -----------------------------------------------------------------------
# QR meal-pass signing
# -----------------------------------------------------------------------
# Signs the "MEALVEST:1:<orderId>:<signature>" QR payload (lib/qr.ts).
# Generate with: openssl rand -hex 32
# Never reuse this value for JWT_ACCESS_SECRET or anything else — a
# leak of one should never compromise the other.
QR_SIGNING_SECRET=replace_with_a_long_random_string

# -----------------------------------------------------------------------
# Paystack — TEST MODE
# -----------------------------------------------------------------------
# Public key is safe to commit here — it identifies your account to
# Paystack's client-side widget/checkout, it is NOT a secret by design.
# This is the real TEST public key provided for this project.
PAYSTACK_PUBLIC_KEY=replace_with_a_long_random_string

# SECRET key — NEVER put the real value here, in this file, in
# GitHub, or anywhere in source. Set the real value directly in
# Netlify: Site configuration -> Environment variables ->
# PAYSTACK_SECRET_KEY. Locally, put it only in your own untracked
# server/.env (already gitignored).
PAYSTACK_SECRET_KEY=replace_with_your_test_secret_key_from_paystack_dashboard

PAYSTACK_BASE_URL=https://api.paystack.co
PAYMENT_PROVIDER_DEFAULT=paystack

# -----------------------------------------------------------------------
# Cyzora — Kenyan M-Pesa payments API (STK push, hosted checkout, payouts)
# -----------------------------------------------------------------------
# Set PAYMENT_PROVIDER_DEFAULT=cyzora (above) to route NEW student
# payments and hotel payouts through Cyzora. Existing Paystack rows keep
# verifying against Paystack; only new ones switch.
#
# SECRET key from the Cyzora dashboard -> API Keys. Test keys start with
# sk_test_ and never move real money; live keys start with sk_live_ and
# env.ts refuses to boot with one unless NODE_ENV=production. Sent as
# the X-API-Key header from server code ONLY — never in the browser, a
# mobile app, or this repo. Set the real value in Vercel's environment
# variables or your own untracked server/.env.
CYZORA_SECRET_KEY=replace_with_your_sk_test_key_from_cyzora_dashboard

# Webhook signing secret (starts with whsec_) from the dashboard's
# Webhooks page, for the endpoint you register there
# (https://<your-domain>/api/webhooks/cyzora). Used only to verify the
# X-Cyzora-Signature HMAC-SHA256 on incoming webhook bodies. A
# different value from the API key — both are required.
CYZORA_WEBHOOK_SECRET=replace_with_your_whsec_webhook_secret

# API base URL — leave as-is unless Cyzora tells you otherwise.
CYZORA_BASE_URL=https://api.cyzora.co.ke/api/v1

# Public origin of the deployed frontend (bare origin, no path). The ONLY
# source for links the server emails (password reset, email verification)
# and for hosted-checkout callback/cancel URLs — never the request's Host
# header. REQUIRED in production (the server refuses to boot without it);
# must be https (http only for localhost). Also add it as an allowed
# redirect domain in the Cyzora dashboard.
APP_BASE_URL=http://localhost:3000

# =======================================================================
# Security remediation (Stage 1 + 2) — see SECURITY_REMEDIATION.md
# =======================================================================

# --- Rate limiting (REQUIRED in production) ---------------------------
# Upstash Redis REST credentials (Upstash console -> your database ->
# REST API). Shared counters across every Vercel instance. Without these
# in production, login/PIN/payment endpoints answer 503 by design.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Emergency-only escape hatch: allow per-instance (weak) memory limits in
# production when Redis is not configured. Leave unset.
# RATE_LIMIT_ALLOW_MEMORY_FALLBACK=true
# Proxy hops in front of the app (Vercel = 1). Only change if you deploy
# behind an additional proxy.
# TRUST_PROXY=1

# --- Cron (REQUIRED for reminders + reconciliation) ---------------------
# Vercel sends "Authorization: Bearer <CRON_SECRET>" to cron paths.
# Generate with: openssl rand -hex 32
CRON_SECRET=

# --- Hotel payout limits (whole KSh) -------------------------------------
# A payout above PAYOUT_MAX_AMOUNT_KES, or one pushing the day's payouts
# above PAYOUT_DAILY_LIMIT_KES, is held for approval by a SECOND admin.
PAYOUT_MAX_AMOUNT_KES=$$$$$$$$
PAYOUT_DAILY_LIMIT_KES=$$$$$$$

# --- Business timezone for daily allowances/rollover (IANA name) --------
BUSINESS_TIMEZONE=Africa/Nairobi

# --- Database TLS verification (strongly recommended in production) -----
# Supabase CA certificate (Dashboard -> Project Settings -> Database ->
# SSL configuration -> Download certificate). Either paste the PEM with
# literal \n line breaks, or point to a file. With a CA set, the server
# verifies the certificate chain AND hostname.
# DATABASE_CA_CERT=-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----
# DATABASE_CA_CERT_PATH=/path/to/supabase-ca.crt
# Make a missing CA a boot failure in production:
# DATABASE_TLS_REQUIRE_VERIFIED=true

# --- Email (Resend): password reset, verification, staff invitations ------
# 1. Create an API key at https://resend.com/api-keys (sending access is enough).
# 2. Add + verify YOUR domain at https://resend.com/domains (add the SPF + DKIM
#    DNS records Resend shows you, e.g. for mealvest.co.ke) and wait for "Verified".
# 3. Set EMAIL_FROM to an address on that domain.
# The shared onboarding@resend.dev sender ONLY delivers to the Resend account
# owner's own address, so in production the server treats it as NOT configured
# (nothing is sent, and the boot log says why). See docs/PRODUCTION_SETUP.md.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM="MEALVEST <no-reply@mealvest.co.ke>"
# TEST ONLY: allow the shared sandbox sender in production so you can try the
# flow with your OWN address before the domain is verified. Leave unset/false.
# ALLOW_RESEND_SANDBOX_SENDER=false

# --- SMS (Africa's Talking): phone verification codes ----------------------
# Use your LIVE app's username (NOT "sandbox" — the sandbox never reaches a real
# phone, so in production it is treated as NOT configured) and its API key, and
# load airtime on that app. See docs/PRODUCTION_SETUP.md.
SMS_PROVIDER=africastalking
AFRICASTALKING_USERNAME=your_live_app_username
AFRICASTALKING_API_KEY=atsk_xxxxxxxxxxxxxxxxxxxxxxxx
# Alphanumeric sender ID — LEAVE BLANK until Africa's Talking has approved one
# for you; a blank value uses their default sender.
AFRICASTALKING_SENDER_ID=

# --- Firebase Cloud Messaging (web push) — SERVER credentials -------------
# From Firebase console → Project settings → Service accounts → "Generate new
# private key". Copy the three fields out of the downloaded JSON:
#   project_id   -> FIREBASE_PROJECT_ID
#   client_email -> FIREBASE_CLIENT_EMAIL
#   private_key  -> FIREBASE_PRIVATE_KEY
# SECRET: these are server-only. Never put them in a REACT_APP_* variable. The
# PUBLIC web config lives in web/.env.example (REACT_APP_FIREBASE_*).
# In Vercel paste the private key exactly as it appears in the JSON (with the
# literal \n sequences, quotes optional) — the server restores real newlines.
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-firebase-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
# Paid-SMS cost caps per rolling 24h.
SMS_DAILY_CAP_PER_USER=5
SMS_DAILY_CAP_GLOBAL=500
# --- Verification enforcement (all OFF by default so no existing account is
# locked out; turn on once email/SMS delivery is confirmed working) ---------
# Require a verified phone before a savings withdrawal.
REQUIRE_VERIFIED_PHONE_FOR_WITHDRAWAL=false
# Require a verified email for sensitive operations: withdrawals, linking a
# Google account, and inviting / reinstating hotel staff. (Removing a staff
# member's access is NEVER blocked by this.)
REQUIRE_VERIFIED_EMAIL_FOR_SENSITIVE_OPS=false

# --- Meal reminders ----------------------------------------------------------
# /api/cron/meal-reminders must be called every 5-15 minutes (see
# docs/PRODUCTION_SETUP.md). Each call reminds students whose own reminder time
# arrived within this many minutes (5-360, default 90).
# MEAL_REMINDER_CATCHUP_MINUTES=90

# --- Hotel image URLs ------------------------------------------------------
# Extra https hosts (comma-separated) hotels may use for image URLs, in
# addition to your Supabase Storage host and images.unsplash.com.
# IMAGE_URL_ALLOWED_HOSTS=

# --- Automated hotel payouts ----------------------------------------------
# Master switch. Anything other than the exact string "true" leaves
# automatic payouts OFF (admin-triggered payouts still work). Turn on only
# after the Cyzora payout.* webhook is confirmed to reach /api/webhooks/cyzora.
AUTO_PAYOUTS_ENABLED=false
# Minimum accumulated unpaid hotel earnings (whole KSh, >=) before a payout
# is created. Applies to automatic AND manual payouts. Never goes below the
# active provider's own minimum (Cyzora: KSh 30).
AUTO_PAYOUT_THRESHOLD_KES=40
# Stop automatic retrying after this many consecutive failed payouts for a
# hotel, and wait this many minutes after any failure. Admin can still retry.
AUTO_PAYOUT_MAX_CONSECUTIVE_FAILURES=3
AUTO_PAYOUT_FAILURE_COOLDOWN_MINUTES=60
# A payout still 'processing' after this long is flagged needs_attention.
PAYOUT_STALE_PROCESSING_MINUTES=120
