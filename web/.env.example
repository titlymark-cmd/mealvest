# -----------------------------------------------------------------------
# MEALVEST web app (Create React App) — environment template
# Copy to .env and adjust for your machine. Only vars prefixed
# REACT_APP_ are readable by the client bundle — that's a CRA
# convention (mirrors the original Expo app's EXPO_PUBLIC_ prefix).
# -----------------------------------------------------------------------

# Where the Express API is reachable from your browser.
# - Local dev: http://localhost:4000 usually works.
# - Same-domain production deploy (frontend + backend on the SAME
#   domain, via Vercel's /api/* rewrite): set this to an EMPTY string.
#   Requests then go to relative "/api/..." paths on whatever domain
#   the app is actually served from — this is intentional, not a
#   placeholder left unfilled. Matches the original app's exact
#   EXPO_PUBLIC_API_BASE_URL behavior (see services/config.ts).
REACT_APP_API_BASE_URL=http://localhost:4000

# -----------------------------------------------------------------------
# Google Sign-In (student/hotel login) — must ALSO be listed in the
# server's GOOGLE_CLIENT_IDS so verifyGoogleIdToken accepts tokens it
# issues. Create in Google Cloud Console -> APIs & Services ->
# Credentials -> OAuth client ID -> Web application. Only the web
# client ID is needed here (the original app's iOS/Android client IDs
# were for native builds, which don't exist in this web-only app).
REACT_APP_GOOGLE_WEB_CLIENT_ID=replace_with_web_client_id.apps.googleusercontent.com

# Note: GOOGLE_MAPS_API_KEY from the original app's .env.example is
# NOT carried over here — it only configured the native iOS/Android
# Maps SDK at build time (app.config.js), and HotelMapScreen (the
# only screen that used it) is dead code in the current deployment,
# not wired into any route. See the migration notes for details.
