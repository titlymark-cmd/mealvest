{
  "name": "mealvest",
  "private": true,
  "version": "1.0.0",
  "description": "Mealvest — Vercel build orchestration root.",
  "workspaces": [
    "web",
    "server"
  ],
  "scripts": {
    "build:server-check": "npm run build --workspace=server",
    "build:web": "npm run build --workspace=web",
    "build": "npm run build:server-check && npm run build:web"
  },
  "engines": {
    "node": "20.x"
  }
}