# -----------------------------------------------------------------------
# MEALVEST app (Expo) — environment template
# Copy to .env and adjust for your machine. Only vars prefixed
# EXPO_PUBLIC_ are readable by the client bundle — that's an Expo
# security convention, not a MEALVEST-specific choice.
# -----------------------------------------------------------------------

# Where the Express API is reachable from your device/simulator.
# - iOS Simulator / web: http://localhost:4000 usually works.
# - Physical device on the same Wi-Fi / Android emulator: use your
#   computer's LAN IP instead of localhost, e.g. http://192.168.1.20:4000
# Local dev (device on the same Wi-Fi as your laptop): use your
# laptop's LAN IP, e.g. http://192.168.1.23:4000 — see server's
# TESTING.md for how to find it. Never "localhost" for a physical
# device; it can't reach your laptop's localhost.
#
# Netlify production deploy (frontend + backend on the SAME domain,
# via netlify/functions/api.ts): set this to an EMPTY string. Requests
# then go to relative "/api/..." paths on whatever domain the app is
# actually served from — this is intentional, not a placeholder left
# unfilled. See DEPLOYMENT.md section 7.
EXPO_PUBLIC_API_BASE_URL=http://localhost:4000

# -----------------------------------------------------------------------
# Google Maps — used ONLY at build time by app.config.js to configure
# the native Android/iOS Maps SDKs. NOT prefixed EXPO_PUBLIC_ on
# purpose: it is read by Node while building the app (app.config.js),
# not by client JS at runtime, so it doesn't need Expo's "safe to ship
# to the client bundle" convention — though functionally, once built,
# it IS embedded in the app binary either way (see the long comment
# in app.config.js for what "secure" actually means for this key).
#
# Get this from Google Cloud Console -> APIs & Services -> Credentials.
# See TESTING.md for exactly which APIs to enable and how to restrict
# this key before using it for anything beyond local testing.
# -----------------------------------------------------------------------
GOOGLE_MAPS_API_KEY=replace_with_your_google_maps_api_key

# -----------------------------------------------------------------------
# Google Sign-In (student/hotel login) — separate from GOOGLE_MAPS_API_KEY
# above, and separate from the server's GOOGLE_CLIENT_IDS, though all
# three client IDs below must ALSO be listed (comma-separated) in the
# server's GOOGLE_CLIENT_IDS so verifyGoogleIdToken accepts tokens they issue.
# Create these in Google Cloud Console -> APIs & Services -> Credentials.
# EXPO_PUBLIC_ prefix is required — these are read by client JS at runtime.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=replace_with_web_client_id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=replace_with_ios_client_id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=replace_with_android_client_id.apps.googleusercontent.com
